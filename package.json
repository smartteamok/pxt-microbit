{
    "name": "pxt-microbit",
    "version": "8.1.13",
    "description": "micro:bit target for Microsoft MakeCode (PXT)",
    "keywords": [
        "JavaScript",
        "education",
        "microbit"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/pxt-microbit.git"
    },
    "author": "",
    "license": "MIT",
    "homepage": "https://github.com/microsoft/pxt-microbit#readme",
    "scripts": {
        "build:target": "pxt buildtarget",
        "package": "pxt buildtarget && pxt staticpkg --route /",
        "package:min": "pxt buildtarget && pxt staticpkg --route / --minify",
        "preview": "npx --yes http-server built/packaged -p 3232 -c-1"
    },
    "files": [
        "README.md",
        "pxtarget.json",
        "targetconfig.json",
        "built/*.js",
        "built/*.json",
        "built/*.d.ts",
        "built/hexcache",
        "built/web",
        "sim/public",
        "docs/*.md",
        "docs/*/*.md",
        "docs/*/*/*.md",
        "docs/static/*.svg",
        "docs/static/*.png",
        "docs/static/icons/favicon.ico"
    ],
    "devDependencies": {
        "@types/dom-mediacapture-record": "1.0.20",
        "@types/marked": "0.3.0",
        "@types/node": "8.10.66",
        "@types/react": "16.4.7",
        "@types/react-dom": "16.0.3",
        "@types/web-bluetooth": "0.0.4",
        "less": "3.13.1",
        "pxt": "0.5.1",
        "react": "16.8.3",
        "react-dom": "16.11.0",
        "semantic-ui-less": "2.4.1",
        "typescript": "4.8.3"
    },
    "dependencies": {
        "pxt-common-packages": "13.2.3",
        "pxt-core": "12.3.9"
    },
    "engines": {
        "node": ">=18"
    },
    "overrides": {}
}
